---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";

const title = "404 Not Found!";
const description = "The page that you navigate is not found!";
---

<Layout title={title} description={description} ogImage="404.png" noindex>
  <div class="w-full mx-auto">
    <PageHeader title={title} eyebrow="Error 404">
      {description}
    </PageHeader>
    <nav class="mt-10 grid border-y border-border sm:grid-cols-2" aria-label="Recovery links">
      <a class="group border-b border-border px-0 py-6 sm:border-e sm:border-b-0 sm:px-6" href="/">
        <span class="text-sm font-medium text-muted-foreground">Return</span>
        <span class="mt-2 block font-medium text-foreground">Homepage →</span>
      </a>
      <a class="group px-0 py-6 sm:px-6" href="/works/">
        <span class="text-sm font-medium text-muted-foreground">Explore</span>
        <span class="mt-2 block font-medium text-foreground">Selected works →</span>
      </a>
    </nav>
  </div>
</Layout>
