---
import NoteRow from "@/components/NoteRow.astro";
import PageHeader from "@/components/PageHeader.astro";
import Panel from "@/components/Panel.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const notesList = await getCollection("notes");
---

<Layout
  title="Notes"
  description="Technical notes on Linux, Kubernetes, Astro, shells, and web development, plus a few personal essays, written in Indonesian and English by Haikel Ilham Hakim."
  url="https://ekel.dev/notes"
  ogImage="notes.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start  mx-auto",
      "md:text-start",
    ]}
  >
    <PageHeader title="Notes" eyebrow="Recent writing">
      Sometimes I write about technical stuff.
    </PageHeader>
    <section data-cy="notes-list" class="w-full">
      <Panel title="All notes" count={notesList.length}>
        {
          notesList
            .sort((a, b) => b.data.created_at.getTime() - a.data.created_at.getTime())
            .map((item) => <NoteRow item={item} testId="note-row" />)
        }
      </Panel>
    </section>
  </div>
</Layout>
