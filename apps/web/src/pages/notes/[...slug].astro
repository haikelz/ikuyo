---
import ArticleMeta from "@/components/ArticleMeta.astro";
import PageHeader from "@/components/PageHeader.astro";
import BackButton from "@/components/svelte/BackButton.svelte";
import ReactionButton from "@/components/svelte/ReactionButton.svelte";
import ReadingIndicator from "@/components/svelte/ReadingIndicator.svelte";
import TOC from "@/components/svelte/TOC.svelte";
import { sanitizeSlug } from "@/helpers/slug";
import Layout from "@/layouts/Layout.astro";
import { BACKEND_API_URL } from "@/utils/env";
import { getCollection, render } from "astro:content";
import { format } from "date-fns";

export async function getStaticPaths() {
  const notesEntries = await getCollection("notes");

  return notesEntries.map((item) => ({
    params: {
      slug: item.id,
    },
    props: {
      item,
    },
  }));
}

const { item } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(item);

const slug = sanitizeSlug(item.id);
---

<Layout
  title={item.data.title}
  description={item.data.description}
  url={`https://ekel.dev/notes/${slug}`}
  ogImage={`notes/${slug}.png`}
  ogImageAlt={item.data.title}
  seoType="article"
  publishedTime={item.data.created_at.toISOString()}
  tags={item.data.tags}
>
  <ReadingIndicator client:only="svelte" />
  <div class="mx-auto w-full min-w-0">
    <BackButton label="back to notes" client:only="svelte" />
    <article>
      <PageHeader title={item.data.title} eyebrow="Technical note">
        {item.data.description}
      </PageHeader>
      <ArticleMeta tags={item.data.tags.map((tag) => ({ label: tag, href: `/tags/${tag}/` }))}>
        {item.data.author} · <time datetime={item.data.created_at.toISOString()}>{format(item.data.created_at, "d MMMM yyyy")}</time> · {remarkPluginFrontmatter.minutesRead}
      </ArticleMeta>
      <p class="arabic-font my-12 text-right text-2xl font-bold text-muted-foreground">
        بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
      </p>
      <div class="prose max-w-none">
        <Content />
      </div>
    </article>
    <div class="mt-12 border-t border-border pt-6">
      <ReactionButton
        slug={slug}
        apiUrl={BACKEND_API_URL}
        client:only="svelte"
      />
    </div>
  </div>
  {
    headings.length > 0 ? (
      <TOC slot="floating" headings={headings} client:only="svelte" />
    ) : null
  }
</Layout>
