---
import WakatimeStats from "@/components/svelte/WakatimeStats.svelte";
import PageHeader from "@/components/PageHeader.astro";
import { api } from "@/configs/ky";
import Layout from "@/layouts/Layout.astro";
import type { WakatimeStatsProps } from "@/types";
import { BACKEND_API_URL } from "@/utils/env";
import { Alert, AlertDescription, AlertTitle } from "@ikuyo/ui";
import { AlertTriangle } from "lucide-svelte";

async function fetchStats(range?: string): Promise<WakatimeStatsProps> {
  const url = range
    ? `${BACKEND_API_URL}/api/v1/wakatime/stats?range=${range}`
    : `${BACKEND_API_URL}/api/v1/wakatime/stats`;
  // Cold all-time stats can take several seconds while WakaTime recalculates them.
  const response = await api.get(url, { timeout: 30_000 }).json<{ data: WakatimeStatsProps }>();
  return response.data;
}

// A backend outage must not fail the whole static build; the page says so instead.
const stats = await Promise.all([fetchStats(), fetchStats("last_7_days")]).catch((error) => {
  console.warn(`[wakatime] stats unavailable at build: ${error}`);
  return null;
});
---

<Layout
  title="Wakatime"
  description="Coding activity and statistics"
  url="https://ekel.dev/wakatime"
  ogImage="wakatime.png"
>
  <div class="flex w-full flex-col items-start justify-start mx-auto md:text-start">
    <PageHeader title="Wakatime" eyebrow="Coding activity">
      Coding activity and statistics.
    </PageHeader>
    <section class="w-full mt-10 sm:mt-16">
      {
        stats ? (
          <WakatimeStats client:only="svelte" allTime={stats[0]} weekly={stats[1]} />
        ) : (
          <Alert role="status" variant="warning" class="rounded-md">
            <AlertTriangle class="size-4" />
            <AlertTitle>Coding stats are unavailable</AlertTitle>
            <AlertDescription>
              The stats service did not respond when this page was built. They return with the
              next deploy.
            </AlertDescription>
          </Alert>
        )
      }
    </section>
  </div>
</Layout>
