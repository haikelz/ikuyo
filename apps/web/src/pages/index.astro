---
import NoteRow from "@/components/NoteRow.astro";
import Panel from "@/components/Panel.astro";
import WorkRow from "@/components/WorkRow.astro";
import OpenToWorkBadge from "@/components/svelte/OpenToWorkBadge.svelte";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const [notesList, worksList, experienceList] = await Promise.all([
  getCollection("notes"),
  getCollection("works"),
  getCollection("experiences"),
]);

const experiences = experienceList.sort((a, b) => a.data.order - b.data.order);
const featuredProjectGroups = [
  {
    title: "Company Projects",
    testId: "featured-works",
    projects: worksList
      .filter((work) => work.data.category === "company")
      .sort((a, b) => a.data.id - b.data.id),
  },
  {
    title: "Personal Projects",
    testId: "featured-personal-works",
    projects: worksList
      .filter((work) => work.data.category === "personal")
      .sort((a, b) => a.data.id - b.data.id)
      .slice(0, 3),
  },
];
const latestNotes = notesList
  .sort((a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime())
  .slice(0, 4);
---

<Layout
  title="Haikel (海克尔)"
  description="Haikel Ilham Hakim, a product engineer in Indonesia building business systems, delivery infrastructure, and content-driven products with Go and TypeScript."
  url="https://ekel.dev"
  ogImage="home.png"
  ogImageAlt="Haikel Ilham Hakim — Product engineer"
  seoType="profile"
>
  <div class="relative mx-auto flex w-full flex-col items-start justify-start">
    <section class="w-full pt-4 sm:pt-8">
      <h1 data-cy="name" class="sr-only">Haikel Ilham Hakim</h1>
      <OpenToWorkBadge client:load />
      <div class="mt-6 flex w-full max-w-full flex-col gap-6 sm:flex-row-reverse sm:items-start sm:gap-10">
        <img
          data-cy="profile-picture"
          src="https://avatars.githubusercontent.com/u/77146709?v=4&s=256"
          alt="Haikel Ilham Hakim"
          width="128"
          height="128"
          class="size-24 shrink-0 rounded-lg border border-border object-cover sm:size-28"
        />
        <div class="min-w-0 flex-1">
          <p class="m-0 max-w-full text-base leading-relaxed text-pretty text-muted-foreground">
            I'm Haikel (<span lang="zh">海克尔</span>), a Product Engineer
            working across business software, delivery infrastructure, and
            content-driven products with Go and TypeScript. I'm currently going
            deeper into Go, DevOps, and finance.
          </p>
          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
            <a
              href="https://www.linkedin.com/in/haikel/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn (opens in new tab)"
              class="font-medium text-foreground transition-colors hover:text-primary"
              >LinkedIn</a
            >
            <a
              href="https://github.com/haikelz"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub (opens in new tab)"
              class="font-medium text-foreground transition-colors hover:text-primary"
              >GitHub</a
            >
            <a
              href="https://gitlab.com/haikelz"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitLab (opens in new tab)"
              class="font-medium text-foreground transition-colors hover:text-primary"
              >GitLab</a
            >
          </div>
        </div>
      </div>
    </section>

    <div class="mt-10 flex w-full flex-col gap-6 sm:mt-14">
      <Panel title="Experience" count={experiences.length} testId="experience">
        {
          experiences.map((experience) => (
            <article class="border-t border-border px-4 py-4 first:border-t-0 sm:px-5">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
                <h3 class="m-0 text-base font-medium text-foreground">
                  {experience.data.hasDetail === false ? (
                    experience.data.company
                  ) : (
                    <a
                      data-cy="experience-link"
                      href={`/experiences/${experience.id}/`}
                      class="text-foreground no-underline transition-colors hover:text-primary"
                    >
                      {experience.data.company}
                    </a>
                  )}
                </h3>
                <span class="shrink-0 text-sm tabular-nums text-muted-foreground">
                  {experience.data.startDate} &ndash; {experience.data.endDate}
                </span>
              </div>
              <p class="m-0 text-sm text-muted-foreground">{experience.data.position}</p>
              <ul role="list" class="mb-0 mt-3 flex list-none flex-col gap-1.5 pl-0">
                {experience.data.highlights.map((highlight) => (
                  <li data-cy="experience-highlight" class="relative max-w-[70ch] pl-4 text-sm leading-relaxed text-pretty">
                    <span aria-hidden="true" class="absolute left-0 top-[0.7em] size-1 rounded-full bg-muted-foreground/60" />
                    {highlight}
                  </li>
                ))}
              </ul>
              {experience.data.hasDetail === false ? null : (
                <a
                  href={`/experiences/${experience.id}/`}
                  class="mt-3 inline-flex min-h-8 items-center text-sm font-medium text-primary no-underline hover:underline"
                >
                  Read case study <span aria-hidden="true">&nbsp;→</span>
                </a>
              )}
            </article>
          ))
        }
      </Panel>

      {
        featuredProjectGroups.map((group) => (
          <Panel title={group.title} href="/works/" testId={group.testId}>
            {group.projects.map((item) => (
              <WorkRow item={item} testId="featured-work" />
            ))}
          </Panel>
        ))
      }

      <Panel title="Latest Notes" href="/notes/" testId="featured-notes">
        {latestNotes.map((item) => <NoteRow item={item} />)}
      </Panel>
    </div>
    <!-- Temporary: the banner replaces the GitHub calendar; it rests on the footer's top divider. -->
    <img
      data-cy="home-banner"
      src="/images/banner.png"
      alt=""
      width="650"
      height="195"
      loading="lazy"
      decoding="async"
      class="mt-12 hidden w-full max-w-xs self-end md:-mb-16 md:block"
    />
  </div>
</Layout>
