---
import Card from "@/components/Card.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const [notesList, worksList, experienceList] = await Promise.all([
  getCollection("notes"),
  getCollection("works"),
  getCollection("experiences"),
]);
---

<Layout
  title="Haikel Ilham Hakim"
  description="Product/Devops"
  url="https://ekel.dev"
  ogImage="home.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start relative mx-auto",
      "md:text-start",
    ]}
  >
    <section class="w-full slide-enter-content mt-8">
      <div class="w-full">
        <div class="mb-6">
          <h1
            data-cy="name"
            class="text-3xl sm:text-4xl md:text-5xl tracking-tighter font-bold mb-4 mt-0 text-foreground"
          >
            Haikel (<span lang="ja">ハイケル</span>)
          </h1>
          <p
            class="text-xl sm:text-2xl text-foreground font-medium tracking-tight mb-2 mt-0"
          >
            Product/Devops
          </p>
          <p class="text-sm sm:text-base text-muted-foreground mb-0 mt-0">
            Indonesia
          </p>
        </div>

        <div class="w-full">
          <p
            data-cy="description"
            class="text-base sm:text-lg leading-7 text-foreground text-justify"
          >
            Konnichiwa! I'm Haikel Ilham Hakim. You can call me <strong
              class="text-foreground font-medium">Haikel/Kel/Ekel</strong
            > with the "E" pronounce is "Emas". I'm a Software Developer familiar
            with <strong class="text-foreground font-medium">js/ts/go</strong>.
            Outside of programming, you can find me doing <a
              href="/photos"
              class="text-foreground font-medium underline decoration-border hover:decoration-foreground transition-colors"
              >street/cosplayer photography</a
            >. Currently, I deep dive into Go, Devops, Finance, also how to deal
            and manage people.
          </p>
          <div class="flex gap-6 mt-6">
            <a
              href="https://www.linkedin.com/in/haikel/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn (opens in new tab)"
              class="text-foreground font-medium hover:text-muted-foreground transition-colors"
              >LinkedIn</a
            >
            <a
              href="https://github.com/haikelz"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub (opens in new tab)"
              class="text-foreground font-medium hover:text-muted-foreground transition-colors"
              >GitHub</a
            >
            <a
              href="https://gitlab.com/haikelz"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitLab (opens in new tab)"
              class="text-foreground font-medium hover:text-muted-foreground transition-colors"
              >GitLab</a
            >
          </div>
        </div>
      </div>
    </section>

    <section
      data-cy="experience"
      class="w-full slide-enter-content mt-10 sm:mt-16"
    >
      <h2
        class="mb-6 sm:mb-8 mt-0 text-2xl sm:text-3xl font-bold tracking-tight text-foreground"
      >
        Experience
      </h2>
      <div class="space-y-6 sm:space-y-8 slide-enter-content">
        {
          experienceList.sort((a, b) => a.data.order - b.data.order).map((experience) => (
            <div class="group relative">
              <div class="relative z-10">
                <div class="flex w-full flex-col items-start justify-start sm:flex-row sm:items-baseline sm:justify-between mb-2">
                  <h3 class="mb-0 mt-0 text-xl sm:text-2xl font-medium tracking-tight text-foreground">
                    {experience.data.hasDetail === false ? (
                      experience.data.company
                    ) : (
                      <a
                        data-cy="experience-link"
                        href={`/experiences/${experience.id}`}
                        class="text-foreground font-medium after:content-['↗'] after:text-[0.75em]! after:opacity-50 hover:text-muted-foreground transition-colors"
                      >
                        {experience.data.company}
                      </a>
                    )}
                  </h3>
                  <span class="mt-2 text-sm font-medium text-muted-foreground sm:mt-0">
                    {experience.data.startDate} &mdash; {experience.data.endDate}
                  </span>
                </div>
                <p class="mb-3 mt-0 text-base sm:text-lg text-foreground">
                  {experience.data.position}
                </p>
                <ul role="list" class="mt-0 space-y-3 text-foreground list-none pl-0">
                  {experience.data.highlights.map((highlight) => (
                    <li class="relative pl-6">
                      <span class="absolute left-0 top-2.5 h-1.5 w-1.5 rounded-full bg-muted-foreground/40" />
                      <p class="my-0 text-base leading-7">{highlight}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section
      data-cy="featured-works"
      class="mt-10 sm:mt-16 w-full slide-enter-content"
    >
      <h2
        class="mt-0 mb-6 sm:mb-8 text-2xl sm:text-3xl font-bold tracking-tight text-foreground"
      >
        Featured Works
      </h2>
      <div
        class="grid w-full grid-cols-1 sm:grid-cols-2 gap-6 slide-enter-content"
      >
        {
          worksList
            .sort((a, b) => a.data.id - b.data.id)
            .slice(1, 5)
            .map((item) => (
              <Card
                title={item.data.title}
                description={item.data.description}
                thumbnail={item.data.thumbnail}
                type="works"
                slug={item.id}
                tags={item.data.stack}
              />
            ))
        }
      </div>
    </section>
    <section data-cy="featured-notes" class="mt-10 sm:mt-16 mb-0 w-full">
      <h2
        class="mt-0 mb-6 sm:mb-8 text-2xl sm:text-3xl font-bold tracking-tight text-foreground"
      >
        Latest Notes
      </h2>
      <div class="grid w-full grid-cols-1 sm:grid-cols-2 gap-6">
        {
          notesList
            .sort(
              (a, b) =>
                new Date(b.data.created_at).getTime() -
                new Date(a.data.created_at).getTime(),
            )
            .slice(0, 4)
            .map((item) => (
              <Card
                title={item.data.title}
                description={item.data.description}
                slug={item.id}
                createdAt={item.data.created_at}
                tags={item.data.tags}
                type="notes"
              />
            ))
        }
      </div>
    </section>
  </div>
</Layout>
