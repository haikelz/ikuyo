---
import BackButton from "@/components/svelte/BackButton.svelte";
import ReadingIndicator from "@/components/svelte/ReadingIndicator.svelte";
import TOC from "@/components/svelte/TOC.svelte";
import { sanitizeSlug } from "@/helpers/slug";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const experienceEntries = await getCollection("experiences");

  return experienceEntries
    .filter((item) => item.data.hasDetail !== false)
    .map((item) => ({
      params: { slug: item.id },
      props: { item },
    }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
const slug = sanitizeSlug(item.id);
---

<Layout
  title={item.data.company}
  description={item.data.description}
  url={`https://ekel.dev/experiences/${slug}`}
  ogImage={`experiences/${slug}.png`}
  ogImageAlt={`${item.data.position} at ${item.data.company}`}
  seoType="article"
  tags={item.data.stack ?? [item.data.position, "Experience"]}
>
  <ReadingIndicator client:only="svelte" />
  <div class="mx-auto w-full">
    <BackButton label="back to experiences" client:only="svelte" />
    <article class="w-full max-w-full">
      <header class="mb-14">
        <p
          class="mb-3 mt-8 text-sm font-medium text-muted-foreground"
        >
          Case study
        </p>
        <h1
          class="mt-0 mb-4 text-2xl leading-tight text-foreground md:text-3xl"
        >
          {item.data.company}
        </h1>
        <p
          data-cy="experience-position"
          class="mb-2 text-lg sm:text-xl text-foreground text-pretty"
        >
          {item.data.position}
        </p>
        <div class="mt-6 border-y border-border py-4">
          <p class="mb-0 text-sm text-muted-foreground tabular-nums">
            {item.data.startDate} &ndash; {item.data.endDate}
          </p>
        </div>
      </header>
      <section
        data-cy="experience-highlights"
        class="mb-14 border-b border-border"
      >
        <h2 class="sr-only">Highlights</h2>
        <ul class="m-0 list-none p-0" role="list">
          {
            item.data.highlights.map((highlight, index) => (
              <li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-t border-border py-5 sm:grid-cols-[3rem_minmax(0,1fr)] sm:gap-x-5">
                <span class="self-start pt-1 text-xs tabular-nums text-muted-foreground">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="m-0 min-w-0 leading-reading text-foreground text-justify hyphens-auto">
                  {highlight}
                </p>
              </li>
            ))
          }
        </ul>
      </section>
      <div
        class="prose max-w-full w-full prose-code:text-sm prose-pre:bg-muted prose-pre:border prose-pre:border-border prose-headings:scroll-mt-24 prose-headings:text-balance"
      >
        <Content />
      </div>
    </article>
  </div>
  {
    headings && headings.length > 0 ? (
      <TOC headings={headings} client:only="svelte" />
    ) : null
  }
</Layout>
