---
import PageHeader from "@/components/PageHeader.astro";
import GuestbookEntries from "@/components/svelte/GuestbookEntries.svelte";
import Layout from "@/layouts/Layout.astro";
import { BACKEND_API_URL } from "@/utils/env";
---

<Layout
  title="Guestbook"
  description="Write a message for me and others."
  url="https://ekel.dev/guestbook"
  ogImage="guestbook.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start  mx-auto",
      "md:text-start",
    ]}
  >
    <PageHeader title="Guestbook" eyebrow="Messages from visitors">
      Write a message for me and others. Go to
      <a
        target="_blank"
        rel="noopener noreferrer"
        aria-label="guestbook.ekel.dev (opens in new tab)"
        href="https://guestbook.ekel.dev"
        class="font-medium text-foreground transition-colors hover:text-muted-foreground"
        >guestbook.ekel.dev</a
      > to add your message.
    </PageHeader>
    <section
      data-cy="guestbook"
      class="w-full mt-10 sm:mt-16"
    >
      <h2 class="sr-only">Guestbook entries</h2>
      <GuestbookEntries client:only="svelte" backendApiUrl={BACKEND_API_URL} />
    </section>
  </div>
</Layout>
