---
import { api } from "@/configs/ky";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import type { GuestbookProps } from "@/types";
import { BACKEND_API_URL } from "@/utils/env";
import { format } from "date-fns";

export async function getGuestbook(): Promise<GuestbookProps[]> {
  try {
    const response = await api
      .get(`${BACKEND_API_URL}/api/v1/guestbook`)
      .json<{ data: GuestbookProps[] }>();
    return response.data;
  } catch (err) {
    throw new Error((err as Error).message);
  }
}

const guestbook = await getGuestbook();
---

<Layout
  title="Guestbook"
  description="Write a message for me and others."
  url="https://ekel.dev/guestbook"
  ogImage="guestbook.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start  mx-auto",
      "md:text-start",
    ]}
  >
    <PageHeader title="Guestbook" eyebrow="Messages from visitors">
      Write a message for me and others. Go to
      <a
        target="_blank"
        rel="noopener noreferrer"
        aria-label="guestbook.ekel.dev (opens in new tab)"
        href="https://guestbook.ekel.dev"
        class="font-medium text-foreground transition-colors hover:text-muted-foreground"
        >guestbook.ekel.dev</a
      > to add your message.
    </PageHeader>
    <section
      data-cy="guestbook"
      class="w-full mt-10 sm:mt-16 slide-enter-content"
    >
      <h2 class="sr-only">Guestbook entries</h2>
      {
        guestbook ? (
          <div class="w-full border-b border-border/70">
            {guestbook
              .sort(
                (a, b) =>
                  new Date(b.created_at).getTime() -
                  new Date(a.created_at).getTime(),
              )
              .map((item) => (
                <article
                  data-cy="guestbook-row"
                  class="grid gap-3 border-t border-border/70 py-6 sm:grid-cols-[8rem_1fr_auto] sm:items-baseline sm:gap-6"
                >
                  <time
                    datetime={new Date(item.created_at).toISOString()}
                    class="font-mono text-xs tabular-nums text-muted-foreground"
                  >
                    {format(item.created_at, "yyyy.MM.dd")}
                  </time>
                  <h3 class="m-0 text-lg font-semibold leading-7 tracking-tight text-foreground text-pretty">
                    {item.message}
                  </h3>
                  <p class="m-0 text-sm font-medium text-muted-foreground">
                    {item.username}
                  </p>
                </article>
              ))}
          </div>
        ) : (
          <p class="font-medium text-muted-foreground">
            There is no message right now!
          </p>
        )
      }
    </section>
  </div>
</Layout>
