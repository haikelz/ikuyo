---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

const notes = await getCollection("notes");

export async function getStaticPaths() {
  const notesEntries = await getCollection("notes");

  const tags = [
    ...new Set(
      notesEntries
        .map((item) => [...new Set(item.data.tags)].join(" "))
        .join(" ")
        .split(" "),
    ),
  ].sort((a, b) => {
    if (a > b) return 1;
    if (a < b) return -1;
    return 0;
  });

  return tags.map((item) => ({
    params: { slug: item },
    props: { item },
  }));
}

const currentPath = Astro.url.pathname.split("/")[2];
---

<Layout
  title={`Notes with tag ${currentPath}`}
  description="Notes with tag"
  url={`https://ekel.dev/tags/${currentPath}`}
  ogImage={`tags/${currentPath}.png`}
>
  <div class="w-full mx-auto slide-enter-content">
    <PageHeader title={`#${currentPath}`} eyebrow="Topic archive">
      Notes tagged with {currentPath}.
    </PageHeader>

    <section class="w-full mt-10 sm:mt-16">
      <h2 class="sr-only">Notes tagged with {currentPath}</h2>
      <div class="w-full border-b border-border/70 slide-enter-content">
        {
          notes
            .filter((item) => item.data.tags.includes(currentPath))
            .sort(
              (a, b) =>
                new Date(b.data.created_at).getTime() -
                new Date(a.data.created_at).getTime(),
            )
            .map((item) => (
              <article class="grid gap-3 border-t border-border/70 py-6 sm:grid-cols-[8rem_1fr_auto] sm:items-baseline sm:gap-6">
                <time
                  datetime={item.data.created_at.toISOString()}
                  class="font-mono text-xs tabular-nums text-muted-foreground"
                >
                  {format(item.data.created_at, "yyyy.MM.dd")}
                </time>
                <div>
                  <h3 class="m-0 text-lg font-semibold tracking-tight text-foreground">
                    <a
                      href={`/notes/${item.id}`}
                      class="no-underline! transition-colors hover:text-muted-foreground"
                    >
                      {item.data.title}
                    </a>
                  </h3>
                  <p class="mb-0 mt-2 max-w-xl text-sm leading-6 text-pretty text-muted-foreground">
                    {item.data.description}
                  </p>
                  <p class="mb-0 mt-3 font-mono text-xs text-muted-foreground">
                    {item.data.tags.join(" · ")}
                  </p>
                </div>
                <a
                  href={`/notes/${item.id}`}
                  aria-label={`Read ${item.data.title}`}
                  class="hidden text-muted-foreground no-underline! transition-transform hover:translate-x-1 hover:text-foreground sm:block"
                >
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
        }
      </div>
    </section>
  </div>
</Layout>
