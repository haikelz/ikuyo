---
import NoteRow from "@/components/NoteRow.astro";
import PageHeader from "@/components/PageHeader.astro";
import Panel from "@/components/Panel.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const notes = await getCollection("notes");

export async function getStaticPaths() {
  const notesEntries = await getCollection("notes");

  const tags = [
    ...new Set(
      notesEntries
        .map((item) => [...new Set(item.data.tags)].join(" "))
        .join(" ")
        .split(" "),
    ),
  ].sort((a, b) => {
    if (a > b) return 1;
    if (a < b) return -1;
    return 0;
  });

  return tags.map((item) => ({
    params: { slug: item },
    props: { item },
  }));
}

const currentPath = Astro.url.pathname.split("/")[2];
const taggedNotes = notes
  .filter((item) => item.data.tags.includes(currentPath))
  .sort((a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime());
// Unique per tag: name its notes, cut near the 160-character search snippet.
const fullDescription = `Notes by Haikel Ilham Hakim tagged ${currentPath}: ${taggedNotes.map((item) => item.data.title).join(", ")}.`;
const description =
  fullDescription.length <= 160
    ? fullDescription
    : `${fullDescription.slice(0, 159).replace(/[\s,]+\S*$/, "")}…`;
---

<Layout
  title={`Notes with tag ${currentPath}`}
  description={description}
  url={`https://ekel.dev/tags/${currentPath}`}
  ogImage={`tags/${currentPath}.png`}
>
  <div class="w-full mx-auto">
    <PageHeader title={`#${currentPath}`} eyebrow="Topic archive">
      Notes tagged with {currentPath}.
    </PageHeader>

    <section class="w-full">
      <Panel title={`Notes tagged with ${currentPath}`} count={taggedNotes.length}>
        {taggedNotes.map((item) => <NoteRow item={item} />)}
      </Panel>
    </section>
  </div>
</Layout>
