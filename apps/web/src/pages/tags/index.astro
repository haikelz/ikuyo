---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getCollection } from "astro:content";

const notes = await getCollection("notes");
const tags = [
  ...new Set(
    notes
      .map((item) => [...new Set(item.data.tags)].join(" "))
      .join(" ")
      .split(" "),
  ),
].sort((a, b) => {
  if (a > b) return 1;
  if (a < b) return -1;
  return 0;
});
---

<Layout
  title="Tags"
  description="Select spesific notes based on the list of tags below."
  url="https://ekel.dev/tags"
  ogImage="tags.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start  mx-auto",
      "md:text-start",
    ]}
  >
    <PageHeader title="Tags" eyebrow="Topics">
      Select specific notes based on the list of tags below.
    </PageHeader>
    <section
      data-cy="tags-list"
      class="w-full slide-enter-content mt-10 sm:mt-16"
    >
      <div
        class="flex w-full flex-wrap items-center justify-start gap-2"
      >
        {
          tags.map((item) => (
            <a
              href={`/tags/${item}`}
              class="border border-border/70 px-3 py-2 font-mono text-xs text-muted-foreground no-underline! transition-colors hover:border-foreground/30 hover:text-foreground"
            >
              <span>#{item}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
