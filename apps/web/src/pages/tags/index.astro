---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const notes = await getCollection("notes");
const tags = [
  ...new Set(
    notes
      .map((item) => [...new Set(item.data.tags)].join(" "))
      .join(" ")
      .split(" "),
  ),
].sort((a, b) => {
  if (a > b) return 1;
  if (a < b) return -1;
  return 0;
});
---

<Layout
  title="Tags"
  description="Browse every note by topic. Each tag page lists its notes newest first, covering Linux, Astro, DevOps, Android, HTTP benchmarking, shells, and more."
  url="https://ekel.dev/tags"
  ogImage="tags.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start  mx-auto",
      "md:text-start",
    ]}
  >
    <PageHeader title="Tags" eyebrow="Topics">
      Select specific notes based on the list of tags below.
    </PageHeader>
    <section data-cy="tags-list" class="w-full">
      <div class="flex w-full flex-wrap items-center justify-start gap-x-4 gap-y-1">
        {
          tags.map((item) => (
            <a
              href={`/tags/${item}/`}
              class="inline-flex min-h-6 items-center text-sm text-muted-foreground"
            >
              #{item}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
