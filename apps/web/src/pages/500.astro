---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";

const title = "500 Internal Server Error!";
const description = "There are some error in the server side!";
---

<Layout title={title} description={description} ogImage="500.png" noindex>
  <div class="w-full mx-auto">
    <PageHeader title={title} eyebrow="Error 500">
      {description}
    </PageHeader>
    <nav class="mt-10 grid border-y border-border sm:grid-cols-2" aria-label="Recovery links">
      <a class="border-b border-border px-0 py-6 no-underline! sm:border-e sm:border-b-0 sm:px-6" href="/">
        <span class="text-xs text-muted-foreground font-medium">Return</span>
        <span class="mt-2 block font-semibold text-foreground">Homepage →</span>
      </a>
      <a class="px-0 py-6 no-underline! sm:px-6" href="/guestbook/">
        <span class="text-xs text-muted-foreground font-medium">Try later</span>
        <span class="mt-2 block font-semibold text-foreground">Open guestbook →</span>
      </a>
    </nav>
  </div>
</Layout>
