---
import PhotosPage from "@/components/svelte/PhotosPage.svelte";
import Layout from "@/layouts/Layout.astro";
import { getAllPhotos } from "@/utils/imagekit";

const images = await getAllPhotos();
const photos = images.map(({ url, thumbnail }) => ({ url, thumbnail }));
// Layout joins classes without merging, so the important modifier beats its max-w-2xl column cap.
---

<Layout
  title="Photos"
  description="A selection of photographs from my camera roll, shown in a gallery where each photo opens in a larger view. Haikel Ilham Hakim's photography on ekel.dev."
  url="https://ekel.dev/photos"
  ogImage="photos.png"
  className="max-w-none!"
>
  <!-- The page shows only photos; the title stays for screen readers, and the top padding matches
       the page header's so the layout switch clears the nav bar's edge fade. -->
  <h1 class="sr-only">Photos</h1>
  <section class="w-full pt-4 sm:pt-8" aria-label="Photo gallery">
    <PhotosPage client:only="svelte" photos={photos} />
  </section>
</Layout>
