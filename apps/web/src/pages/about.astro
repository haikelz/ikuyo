---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const currentRoles = (await getCollection("experiences"))
  .filter(({ data }) => data.endDate === "Present")
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="About"
  description="About Haikel Ilham Hakim, a product engineer in Indonesia who builds business software and delivery infrastructure with Go and TypeScript, and the current role."
  url="https://ekel.dev/about"
  ogImage="about.png"
  seoType="profile"
>
  <div class="mx-auto flex w-full flex-col items-start justify-start">
    <PageHeader title="About" eyebrow="Profile">
      Who I am, what I build, and where I work now.
    </PageHeader>

    <section
      class="mt-10 flex w-full flex-col gap-6 sm:mt-16 sm:flex-row-reverse sm:items-start sm:gap-10"
    >
      <img
        data-cy="about-picture"
        src="https://avatars.githubusercontent.com/u/77146709?v=4&s=320"
        alt="Haikel Ilham Hakim"
        width="160"
        height="160"
        class="size-28 shrink-0 rounded-xl border border-border object-cover sm:size-40"
      />
      <div
        data-cy="about-bio"
        class="flex min-w-0 flex-1 flex-col gap-6 text-lg leading-8 text-muted-foreground text-pretty"
      >
        <p class="my-0">
          I'm Haikel Ilham Hakim (<span lang="zh">海克尔</span>), a Product Engineer based in
          Indonesia. I build business software, delivery infrastructure, and content-driven
          products with Go and TypeScript.
        </p>
        <p class="my-0">
          I started building for the web in 2022 as a frontend developer, then took on
          full-stack, IT operations, and deployment work. Along the way I built instant-order
          and real-time courier tracking features for a logistics platform, finance and
          correspondence-archiving SaaS products, and a company profile moved from WordPress to
          Astro and Directus.
        </p>
        <p class="my-0">
          Right now I'm going deeper into Go, DevOps, and finance, and I write down what I learn
          in my <a href="/notes/" class="text-foreground hover:text-muted-foreground">notes</a>.
        </p>
      </div>
    </section>

    {
      currentRoles.length > 0 ? (
        <section data-cy="current-work" class="mt-16 w-full sm:mt-24">
          <div class="mb-8">
            <p class="mb-3 mt-0 font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">
              Now
            </p>
            <h2 class="mb-0 mt-0 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
              Currently working at
            </h2>
          </div>
          <div class="border-b border-border/70">
            {currentRoles.map((role) => (
              <article class="flex flex-col items-start gap-2 border-t border-border/70 py-6 sm:flex-row sm:items-baseline sm:justify-between">
                <div>
                  <h3 class="mb-1 mt-0 text-xl font-bold tracking-tight text-foreground sm:text-2xl">
                    {role.data.hasDetail === false ? (
                      role.data.company
                    ) : (
                      <a
                        href={`/experiences/${role.id}/`}
                        class="text-foreground no-underline! transition-colors hover:text-muted-foreground"
                      >
                        {role.data.company}
                      </a>
                    )}
                  </h3>
                  <p class="mb-0 mt-0 text-base text-foreground">{role.data.position}</p>
                </div>
                <span class="text-sm font-medium tabular-nums text-muted-foreground">
                  Since {role.data.startDate}
                </span>
              </article>
            ))}
          </div>
        </section>
      ) : null
    }
  </div>
</Layout>
