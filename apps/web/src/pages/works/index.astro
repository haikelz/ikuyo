---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import WorkRow from "@/components/WorkRow.astro";
import { getCollection } from "astro:content";

const worksList = await getCollection("works");
const projectGroups = [
  {
    title: "Company Projects",
    testId: "company-projects",
    projects: worksList
      .filter((work) => work.data.category === "company")
      .sort((a, b) => a.data.id - b.data.id),
  },
  {
    title: "Personal Projects",
    testId: "personal-projects",
    projects: worksList
      .filter((work) => work.data.category === "personal")
      .sort((a, b) => a.data.id - b.data.id),
  },
];
---

<Layout
  title="Works"
  description="List some of my works."
  url="https://ekel.dev/works"
  ogImage="works.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start  mx-auto",
      "md:text-start",
    ]}
  >
    <PageHeader title="Works" eyebrow="Company and personal projects">
      Browse projects I've built with teams and on my own.
    </PageHeader>
    <section
      data-cy="works-list"
      class="w-full mt-10 sm:mt-16 slide-enter-content"
    >
      {projectGroups.map((group) => (
        <section data-cy={group.testId} class="mb-14 w-full last:mb-0">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-foreground">
            {group.title}
          </h2>
          <div class="border-b border-border/70">
            {group.projects.map((item) => (
              <WorkRow item={item} testId="work-row" />
            ))}
          </div>
        </section>
      ))}
    </section>
  </div>
</Layout>
