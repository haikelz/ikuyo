---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Panel from "@/components/Panel.astro";
import WorkRow from "@/components/WorkRow.astro";
import { getCollection } from "astro:content";

const worksList = await getCollection("works");
const projectGroups = [
  {
    title: "Company Projects",
    testId: "company-projects",
    projects: worksList
      .filter((work) => work.data.category === "company")
      .sort((a, b) => a.data.id - b.data.id),
  },
  {
    title: "Personal Projects",
    testId: "personal-projects",
    projects: worksList
      .filter((work) => work.data.category === "personal")
      .sort((a, b) => a.data.id - b.data.id),
  },
];
---

<Layout
  title="Works"
  description="Company and personal projects by Haikel Ilham Hakim, from logistics, healthcare, and university admissions systems to public Go APIs and small web tools."
  url="https://ekel.dev/works"
  ogImage="works.png"
>
  <div
    class:list={[
      "flex w-full flex-col items-start justify-start  mx-auto",
      "md:text-start",
    ]}
  >
    <PageHeader title="Works" eyebrow="Company and personal projects">
      Browse projects I've built with teams and on my own.
    </PageHeader>
    <section data-cy="works-list" class="flex w-full flex-col gap-6">
      {projectGroups.map((group) => (
        <Panel title={group.title} count={group.projects.length} testId={group.testId}>
          {group.projects.map((item) => (
            <WorkRow item={item} testId="work-row" />
          ))}
        </Panel>
      ))}
    </section>
  </div>
</Layout>
