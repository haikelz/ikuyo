---
import ArticleMeta from "@/components/ArticleMeta.astro";
import PageHeader from "@/components/PageHeader.astro";
import BackButton from "@/components/svelte/BackButton.svelte";
import ReadingIndicator from "@/components/svelte/ReadingIndicator.svelte";
import TOC from "@/components/svelte/TOC.svelte";
import { sanitizeSlug } from "@/helpers/slug";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const worksEntries = await getCollection("works");

  return worksEntries.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(item);

const slug = sanitizeSlug(item.id);
// Tag pages exist only for note tags; other stack items stay plain text.
const noteTags = new Set((await getCollection("notes")).flatMap((note) => note.data.tags));
---

<Layout
  title={item.data.title}
  description={item.data.description}
  url={`https://ekel.dev/works/${slug}`}
  ogImage={`works/${slug}.png`}
  ogImageAlt={`${item.data.title} project by Haikel Ilham Hakim`}
  seoType="article"
  tags={item.data.stack}
>
  <ReadingIndicator client:only="svelte" />
  <div class="mx-auto w-full min-w-0">
    <BackButton label="back to works" client:only="svelte" />
    <article>
      <PageHeader title={item.data.title} eyebrow="Project archive">
        {item.data.description}
      </PageHeader>
      <ArticleMeta
        tags={item.data.stack.map((tag) => ({
          label: tag,
          href: noteTags.has(tag) ? `/tags/${tag}/` : undefined,
        }))}
      >
        {item.data.author} · {remarkPluginFrontmatter.minutesRead}
        {
          item.data.preview ? (
            <>
              {" · "}
              <a href={item.data.preview} target="_blank" rel="noopener noreferrer" aria-label="Preview (opens in new tab)">
                Preview
              </a>
            </>
          ) : null
        }
        {
          item.data.repo ? (
            <>
              {" · "}
              <a href={item.data.repo} target="_blank" rel="noopener noreferrer" aria-label="Source (opens in new tab)">
                Source
              </a>
            </>
          ) : null
        }
      </ArticleMeta>
      <p class="arabic-font my-12 text-right text-2xl font-bold text-muted-foreground">
        بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
      </p>
      <div class="prose max-w-none">
        <Content />
      </div>
    </article>
  </div>
  {
    headings.length > 0 ? (
      <TOC slot="floating" headings={headings} client:only="svelte" />
    ) : null
  }
</Layout>
