---
import PhotoGrid from "@/components/svelte/PhotoGrid.svelte";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Uses"
  description="My current usage of stuffs."
  url="https://ekel.dev/uses"
  ogImage="uses.png"
>
  <div class="mx-auto flex w-full flex-col items-start justify-start">
    <PageHeader title="Uses" eyebrow="Current setup">
      My current hardware and software setup.
    </PageHeader>

    <section class="mt-10 w-full slide-enter-content sm:mt-16">
      <header class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="m-0 font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">
          Around the desk
        </h2>
        <span class="font-mono text-xs tabular-nums text-muted-foreground">04 photos</span>
      </header>
      <div class="border-y border-border/70 py-4">
        <PhotoGrid
          client:only
          images={[
            "/images/uses.png",
            "/images/IMG_1205.png",
            "/images/hobby-related.jpeg",
            "/images/IMG_1267.png",
          ]}
        />
      </div>
    </section>

    <section class="mt-16 w-full slide-enter-content sm:mt-24">
      <header class="mb-6">
        <p class="mb-3 mt-0 font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">
          Tools of the trade
        </p>
        <h2 class="m-0 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
          Daily setup
        </h2>
      </header>

      <dl class="m-0 border-b border-border/70">
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Editor</dt>
          <dd class="m-0 leading-7 text-foreground">Trae, Cursor, and Neovim.</dd>
        </div>
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Laptop</dt>
          <dd class="m-0 leading-7 text-foreground">
            Lenovo ThinkBook 14 G2 ARE (Ryzen 4500U), <strong class="font-medium">24GB RAM</strong>
            (8GB soldered + 16GB Kingston Fury Impact), and <strong class="font-medium">1TB storage</strong>
            (512GB Samsung NVMe + 512GB Team Elite EX2 SATA 2.5).
          </dd>
        </div>
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Mouse</dt>
          <dd class="m-0 leading-7 text-foreground">Logitech Pebble M350 (2022).</dd>
        </div>
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Keyboard</dt>
          <dd class="m-0 leading-7 text-foreground">
            <s class="text-muted-foreground">Royal Kludge RKG68 (2022)</s> Noir Timeless82 V1
            (used barebone) + Akko V3 Cream Blue Pro.
          </dd>
        </div>
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Operating system</dt>
          <dd class="m-0 leading-7 text-foreground">Fedora Linux + Windows 10 Home dual boot.</dd>
        </div>
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Phone</dt>
          <dd class="m-0 leading-7 text-foreground">
            <s class="text-muted-foreground">Sony Xperia X Compact</s> iPhone SE 3 (2022).
          </dd>
        </div>
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Camera</dt>
          <dd class="m-0 leading-7 text-foreground">Sony A5000 + TTArtisan 56mm f/1.8.</dd>
        </div>
        <div class="grid gap-2 border-t border-border/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Audio</dt>
          <dd class="m-0 leading-7 text-foreground">
            Moondrop Chu 2 + modular Pula Unicrom cable +
            <s class="text-muted-foreground">FiiO JA11 DAC (sold)</s> Moondrop Dawn Pro +
            Akliam C5 USB-C-to-Lightning cable / FiiO Snowsky Echo Mini DAP.
          </dd>
        </div>
      </dl>
    </section>
  </div>
</Layout>
