---
import type { CollectionEntry } from "astro:content";
import { format } from "date-fns";

type Props = {
  item: CollectionEntry<"notes">;
  testId?: string;
};

const { item, testId } = Astro.props;
---

<article data-cy={testId} class="border-t border-border px-4 py-4 first:border-t-0 sm:px-5">
  <div class="mb-1 flex flex-col sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
    <h3 class="m-0 text-base font-medium text-foreground">
      <a
        href={`/notes/${item.id}/`}
        class="text-foreground no-underline transition-colors hover:text-primary"
      >
        {item.data.title}
      </a>
    </h3>
    <time datetime={item.data.created_at.toISOString()} class="shrink-0 text-sm tabular-nums text-muted-foreground">
      {format(item.data.created_at, "d MMM yyyy")}
    </time>
  </div>
  <p class="m-0 text-sm leading-relaxed text-justify hyphens-auto text-muted-foreground">
    {item.data.description}
  </p>
  {
    item.data.tags.length > 0 ? (
      <p class="mb-0 mt-2 text-xs leading-relaxed text-muted-foreground">
        {item.data.tags.map((tag) => `#${tag}`).join(" ")}
      </p>
    ) : null
  }
</article>
