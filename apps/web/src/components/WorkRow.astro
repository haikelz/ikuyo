---
import type { CollectionEntry } from "astro:content";

type Props = {
  item: CollectionEntry<"works">;
  testId: string;
};

const { item, testId } = Astro.props;
const thumbnail = item.data.thumbnail ?? `/og/works/${item.id}.png`;
---

<article
  data-cy={testId}
  class="grid grid-cols-[5rem_1fr] items-start gap-4 border-t border-border px-4 py-4 first:border-t-0 sm:grid-cols-[7rem_1fr] sm:px-5"
>
  <img
    src={thumbnail}
    alt={`${item.data.title} thumbnail`}
    width="112"
    height="63"
    loading="lazy"
    decoding="async"
    class="aspect-video w-full rounded-md border border-border object-cover"
  />
  <div class="min-w-0">
    <h3 class="m-0 text-sm font-medium text-foreground">
      <a
        href={`/works/${item.id}/`}
        class="text-foreground no-underline transition-colors hover:text-primary"
      >
        {item.data.title}
      </a>
    </h3>
    <p class="mb-0 mt-1 max-w-[70ch] leading-relaxed text-pretty text-muted-foreground">
      {item.data.description}
    </p>
    {
      item.data.stack.length > 0 ? (
        <p class="mb-0 mt-2 text-xs text-muted-foreground">{item.data.stack.join(" · ")}</p>
      ) : null
    }
  </div>
</article>
