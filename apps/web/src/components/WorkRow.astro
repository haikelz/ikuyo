---
import type { CollectionEntry } from "astro:content";

type Props = {
  item: CollectionEntry<"works">;
  testId: string;
};

const { item, testId } = Astro.props;
const thumbnail = item.data.thumbnail ?? `/og/works/${item.id}.png`;
---

<article
  data-cy={testId}
  class="grid grid-cols-[5rem_minmax(0,1fr)] items-center gap-x-4 border-t border-border py-4 first:border-t-0 sm:grid-cols-[7rem_minmax(0,1fr)] sm:grid-rows-[auto_auto_1fr] sm:items-start"
>
  <!-- Phones: the thumbnail sits beside the title only, so the justified description gets the full row width. -->
  <img
    src={thumbnail}
    alt={`${item.data.title} thumbnail`}
    width="112"
    height="63"
    loading="lazy"
    decoding="async"
    class="aspect-video w-full rounded-md border border-border object-cover sm:row-span-3"
  />
  <h3 class="m-0 min-w-0 text-base font-medium text-foreground">
    <a
      href={`/works/${item.id}/`}
      class="text-foreground no-underline transition-colors hover:text-primary"
    >
      {item.data.title}
    </a>
  </h3>
  <p class="col-span-2 mb-0 mt-3 text-sm leading-relaxed text-justify hyphens-auto text-muted-foreground sm:col-span-1 sm:col-start-2 sm:mt-1">
    {item.data.description}
  </p>
  {
    item.data.stack.length > 0 ? (
      <p class="col-span-2 mb-0 mt-2 text-xs leading-relaxed text-muted-foreground sm:col-span-1 sm:col-start-2">{item.data.stack.join(" · ")}</p>
    ) : null
  }
</article>
