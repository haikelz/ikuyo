---
type Props = {
  title: string;
  count?: number;
  href?: string;
  testId?: string;
  class?: string;
};

const { title, count, href, testId, class: className } = Astro.props;
---

<section
  data-cy={testId}
  class:list={["w-full", className]}
>
  <div class="flex items-center justify-between gap-3 border-b border-border pb-3">
    <h2 class="m-0 text-lg leading-snug text-foreground">{title}</h2>
    <div class="flex items-center gap-3">
      {
        count !== undefined ? (
          <span class="rounded-md bg-secondary px-2 py-px text-xs font-medium tabular-nums text-muted-foreground">
            {count}
          </span>
        ) : null
      }
      {
        href ? (
          <a
            href={href}
            class="text-sm font-medium text-muted-foreground"
          >
            View all <span aria-hidden="true">→</span>
          </a>
        ) : null
      }
    </div>
  </div>
  <div>
    <slot />
  </div>
</section>
