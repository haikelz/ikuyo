---
import Pronounced from "@/components/svelte/Pronounced.svelte";
import { hasPronunciation } from "@/utils/pronunciation";

type Props = {
  title: string;
  eyebrow: string;
  className?: string;
};

const { title, eyebrow, className = "" } = Astro.props;
---

<header class:list={["w-full pt-4 pb-6 sm:pt-8", className]}>
  <p class="mb-3 mt-0 text-sm font-medium text-muted-foreground">{eyebrow}</p>
  <h1
    data-cy="heading"
    class="m-0 text-2xl leading-tight text-foreground md:text-3xl"
  >
    {hasPronunciation(title) ? <Pronounced title={title} /> : title}
  </h1>
  <div data-cy="description" class="mt-2 leading-reading text-justify hyphens-auto text-muted-foreground">
    <slot />
  </div>
</header>
