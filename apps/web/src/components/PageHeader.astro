---
type Props = {
  title: string;
  eyebrow: string;
  className?: string;
};

const { title, eyebrow, className = "" } = Astro.props;
---

<header class:list={["w-full pt-4 pb-6 sm:pt-8", className]}>
  <p class="mb-3 mt-0 text-sm font-medium text-muted-foreground">{eyebrow}</p>
  <h1
    data-cy="heading"
    class="m-0 text-2xl font-semibold leading-tight tracking-tight text-foreground sm:text-[1.75rem]"
  >
    {title}
  </h1>
  <div data-cy="description" class="mt-2 max-w-[46ch] text-muted-foreground">
    <slot />
  </div>
</header>
